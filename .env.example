# Copy this file to .env and fill in your real credentials.
# NEVER commit .env or share real API keys.

# ─────────────────────────────────────────────────────────────────────────────
# TextBee Android Gateway SMS  (PRIMARY SMS channel — confirmed working)
# Get credentials at https://textbee.dev/dashboard
# ─────────────────────────────────────────────────────────────────────────────
TEXTBEE_API_KEY=replace_with_your_textbee_api_key
TEXTBEE_DEVICE_ID=replace_with_your_textbee_device_id
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Twilio WhatsApp  (WhatsApp channel — Twilio Sandbox / Business API)
# Get credentials at https://console.twilio.com
# Sandbox number +14155238886 requires recipients to send 'join <keyword>' first.
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_WA_FROM=whatsapp:+14155238886

# ─────────────────────────────────────────────────────────────────────────────
# Twilio SMS (DEPRECATED — replaced by TextBee)
# Leave as placeholder; only TWILIO_WA_FROM above is used now.
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_SMS_FROM=+1xxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB  (Optional — required only for persistent SOS history)
# Without this, SOS logs are stored in memory and lost on restart.
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=replace_with_your_mongodb_connection_string
MONGODB_DATABASE=rakshai_db
MONGODB_SOS_COLLECTION=sos_logs
